# Copy to `.env.local` for local development:  cp .env.local.example .env.local
# Only NEXT_PUBLIC_* values are used, and they are inlined into the browser bundle at build time -
# never put secrets here.

# Base URL of the worker-api Cloudflare Worker (see worker-api/README.md for deployment steps).
# Local default when running `npm run dev` inside worker-api/ (wrangler dev):
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8787

# Sub-path when the static site is served from a GitHub Pages project site, e.g. /Portfolio.
# Leave unset (or empty) for local development and for a custom domain served from the root.
# In CI this is set by .github/workflows/pages.yml, not here.
# NEXT_PUBLIC_BASE_PATH=/Portfolio

# Umami analytics (optional, opt-in). With no website ID no tracking script is loaded at all.
# Get an ID from https://cloud.umami.is (or your self-hosted instance) and uncomment:
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
