{
  "name": "worker-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply dinesh-portfolio-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply dinesh-portfolio-leads --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "agents": "^0.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.147.0"
  }
}
