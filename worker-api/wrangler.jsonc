{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinesh-portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [{ "name": "PortfolioMCP", "class_name": "PortfolioMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PortfolioMCP"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinesh-portfolio-leads",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every 10 minutes: email transcripts of abandoned chats, purge expired sessions.
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "OWNER_EMAIL": "sanjudinesh169@gmail.com"
  }
  // RESEND_API_KEY is a secret, set with `wrangler secret put RESEND_API_KEY`
  // after deployment — see README.md "Manual setup before going live".
}
