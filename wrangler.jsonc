{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dinesh-portfolio",
  "main": ".open-next/worker.js",
  "keep_names": false,
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {}
}
